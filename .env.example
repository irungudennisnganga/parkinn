# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/parking_altura

# Redis (optional — falls back to DB-only if unavailable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# HikCentral
HIK_BASE_URL=https://your-hikcentral-instance.com
HIK_ACCESS_KEY=your_access_key
HIK_SECRET_KEY=your_secret_key
HIKCENTRAL_CALLBACK_URL=https://your-domain.com/events

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your_ck
MPESA_CONSUMER_SECRET=your_cs
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/callback
MPESA_PARTY_B=174379

# Payment defaults
DEFAULT_RATE_PER_HOUR=100
DEFAULT_GRACE_MINUTES=15

# Cache TTL (seconds)
CACHE_ACTIVE_SESSIONS_TTL=30
CACHE_DASHBOARD_TTL=60

# Reconciliation intervals (milliseconds)
RECONCILE_INTERVAL_MS=60000
STALE_CLEANUP_INTERVAL_MS=60000

# Registered vehicles floor access
RESIDENTIAL_FLOORS=5,6,7,8,9
COMMERCIAL_FLOORS=1,2,3,4
